*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -s 0.0.0.0/0 -d 0.0.0.0/0 -j ACCEPT
-A INPUT -p tcp -s 0.0.0.0/0 -d 0.0.0.0/0 --dport 22 -j ACCEPT
-A INPUT -p tcp -s 0.0.0.0/0 -d 0.0.0.0/0 --dport 3389 -j ACCEPT
-A INPUT -p tcp -s 10.0.0.0/8 -d 0.0.0.0/0 --dport 22 -j DROP
COMMIT
